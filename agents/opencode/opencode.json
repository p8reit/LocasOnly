{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "ollama"
  ],
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LocasOnly (local Ollama)",
      "options": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B planner",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B builder",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "ollama/qwen2.5-coder:7b",
  "agent": {
    "plan": {
      "model": "ollama/qwen3.5:9b",
      "description": "Read-only planning and repository analysis.",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "build": {
      "model": "ollama/qwen2.5-coder:7b",
      "description": "Coding and approved test execution."
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "grep": "allow",
    "glob": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny"
    },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
